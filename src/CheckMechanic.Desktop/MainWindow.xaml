<Window x:Class="CheckMechanic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic" Width="1366" Height="820" MinWidth="1280" MinHeight="720">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="132" />
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CheckMechanic" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Local Telemetry Dashboard" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Style="{DynamicResource StatusBadgeStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}">
                    <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="再チェック" Width="112" Margin="0,0,8,0" Click="RecheckButton_OnClick" Background="{DynamicResource AccentBrush}" Foreground="#04120F" BorderBrush="{DynamicResource AccentBrush}" />
                    <Button Content="Core Temp 起動/前面" Width="170" Margin="0,0,8,0" Click="LaunchOrActivateCoreTempButton_OnClick" />
                    <Button x:Name="MoreActionsButton" Content="⋯" Width="44" Click="MoreActionsButton_OnClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="管理者で再試行" Click="RestartHelperAsAdminButton_OnClick" />
                                <MenuItem Header="SensorHelper再起動" Click="RestartHelperButton_OnClick" />
                                <MenuItem Header="再接続" Click="ReconnectButton_OnClick" />
                                <Separator />
                                <MenuItem Header="診断エクスポート" Click="ExportDiagnosticsButton_OnClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="74" Height="74" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="8" />
                        <Path Data="{Binding TempRingArcData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="{Binding TempRingCenterText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Temperature" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding CpuTemperatureText}" Style="{DynamicResource GlowValueStyle}" FontSize="26" />
                        <TextBlock Text="{Binding TempSourceText}" Style="{DynamicResource MetricSubStyle}" />
                        <TextBlock Text="{Binding TempStatsText}" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="CPU Util" Style="{DynamicResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding CpuKpiText}" Style="{DynamicResource MetricValueStyle}" FontSize="30" />
                    <ProgressBar Height="8" Margin="0,10,0,0" Value="{Binding CpuUtilizationValue}" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Surface2Brush}" />
                    <TextBlock Text="{Binding CpuAvgText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Margin="8,0,4,0">
                <StackPanel>
                    <TextBlock Text="Memory" Style="{DynamicResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding MemoryKpiText}" Style="{DynamicResource MetricValueStyle}" FontSize="24" />
                    <ProgressBar Height="8" Margin="0,10,0,0" Value="{Binding MemoryUtilizationValue}" Maximum="100" Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource Surface2Brush}" />
                    <TextBlock Text="{Binding MemorySubText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{DynamicResource CardStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="PerfScore" Style="{DynamicResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding PerfScoreText}" Style="{DynamicResource GlowValueStyle}" FontSize="36" />
                    <TextBlock Text="{Binding PerfSummaryText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Disk Throughput" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DiskText}" Style="{DynamicResource MetricValueStyle}" FontSize="24" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="↓ Read / ↑ Write" Style="{DynamicResource MetricSubStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="8,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Network" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding NetText}" Style="{DynamicResource MetricValueStyle}" FontSize="24" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="↓ Recv / ↑ Sent" Style="{DynamicResource MetricSubStyle}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource ChartCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Temperature" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding TempLatestText}" Style="{DynamicResource MetricSubStyle}"/></Grid>
                        <Canvas Grid.Row="1" Height="190" Margin="0,8,0,0"><Rectangle Width="780" Height="190" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="8" RadiusY="8"/><Path Data="{Binding TempChartData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/></Canvas>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{DynamicResource ChartCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU Util" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding CpuLatestText}" Style="{DynamicResource MetricSubStyle}"/></Grid>
                        <Canvas Grid.Row="1" Height="190" Margin="0,8,0,0"><Rectangle Width="780" Height="190" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="8" RadiusY="8"/><Path Data="{Binding CpuChartData}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"/></Canvas>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{DynamicResource ChartCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Memory Util" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding MemLatestText}" Style="{DynamicResource MetricSubStyle}"/></Grid>
                        <Canvas Grid.Row="1" Height="190" Margin="0,8,0,0"><Rectangle Width="780" Height="190" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="8" RadiusY="8"/><Path Data="{Binding MemChartData}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="2"/></Canvas>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="270" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="System Profile" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <CheckBox Content="Opt-in" IsChecked="{Binding OptInConsent}" Margin="10,1,0,0" />
                            <Button Content="更新" Width="70" Margin="8,0,0,0" Click="RefreshProfileButton_OnClick" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="OS" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding ProfileOsText}"/>
                            <TextBlock Grid.Row="1" Text="CPU" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileCpuBrand}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="Cores" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileCoreText}"/>
                            <TextBlock Grid.Row="3" Text="Memory" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileMemoryBucket}"/>
                            <TextBlock Grid.Row="4" Text="GPU" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileGpuName}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="5" Text="Storage" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProfileStorageText}"/>
                            <TextBlock Grid.Row="6" Text="Provider" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProfileTempProvider}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Score Breakdown" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="CPU" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Value="{Binding ScoreCpuValue}" Maximum="100" Height="8" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding ScoreCpuText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="Memory" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Value="{Binding ScoreMemValue}" Maximum="100" Height="8" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding ScoreMemText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="Disk" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Value="{Binding ScoreDiskValue}" Maximum="100" Height="8" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding ScoreDiskText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="Network" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Value="{Binding ScoreNetValue}" Maximum="100" Height="8" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding ScoreNetText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="Thermal" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Value="{Binding ScoreTempValue}" Maximum="100" Height="8" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding ScoreTempText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <TextBlock Text="{Binding LocalRankingText}" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Row="1" Text="{Binding DiagnosticsSummaryText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,8" TextWrapping="Wrap" />
                        <Expander Grid.Row="2" Header="Diagnostics ▼" IsExpanded="False">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="ログをコピー" Width="120" Click="CopyLogsButton_OnClick" />
                                        <Button Content="診断更新" Width="110" Margin="8,0,0,0" Click="RefreshDiagnosticsButton_OnClick" />
                                    </StackPanel>
                                    <CheckBox Content="終了時に Core Temp も終了する" IsChecked="{Binding CloseCoreTempOnExitConsent}" Margin="0,0,0,8" />
                                    <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding DiagnosticSensorsText}" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True" Margin="8,0,0,0" />
                            </Grid>
                        </Expander>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
