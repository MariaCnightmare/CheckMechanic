<Window x:Class="CheckMechanic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic" Height="780" Width="1200" MinWidth="1024" MinHeight="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource CardStyle}" Padding="16" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="CheckMechanic" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="温度必須モード / ローカルテレメトリダッシュボード" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{DynamicResource StatusBadgeStyle}" Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="Core Tempを起動/前面へ" Width="185" Margin="12,0,8,0" Click="LaunchOrActivateCoreTempButton_OnClick" />
                    <Button Content="再チェック" Width="110" Margin="0,0,8,0" Click="RecheckButton_OnClick" />
                    <Button Content="管理者で再試行" Width="130" Click="RestartHelperAsAdminButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,14,0,0">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="86" Height="86">
                                        <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="10" />
                                        <Path Data="{Binding TempRingArcData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <TextBlock Text="{Binding TempRingCenterText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CPU Temperature" Style="{DynamicResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding CpuTemperatureText}" Style="{DynamicResource GlowValueStyle}" FontSize="24" />
                                        <TextBlock Text="{Binding TempLatestText}" Style="{DynamicResource MetricSubStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="CPU Utilization" Style="{DynamicResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding CpuUtilizationText}" Style="{DynamicResource MetricValueStyle}" FontSize="24" />
                                    <ProgressBar Height="8" Margin="0,10,0,0" Value="{Binding CpuUtilizationValue}" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Surface2Brush}" />
                                    <TextBlock Text="リアルタイム負荷" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Memory" Style="{DynamicResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding MemoryText}" Style="{DynamicResource MetricValueStyle}" FontSize="24" />
                                    <ProgressBar Height="8" Margin="0,10,0,0" Value="{Binding MemoryUtilizationValue}" Maximum="100" Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource Surface2Brush}" />
                                    <TextBlock Text="used / total" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Disk Throughput" Style="{DynamicResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding DiskText}" Style="{DynamicResource MetricValueStyle}" FontSize="20" />
                                    <TextBlock Text="↓ read / ↑ write" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Network" Style="{DynamicResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding NetText}" Style="{DynamicResource MetricValueStyle}" FontSize="20" />
                                    <TextBlock Text="↓ receive / ↑ send" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PerfScore" Style="{DynamicResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding PerfScoreText}" Style="{DynamicResource GlowValueStyle}" FontSize="34" />
                                    <TextBlock Text="現在の総合状態" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="14" Margin="0,0,0,12" Background="{DynamicResource Surface2Brush}">
                            <StackPanel>
                                <TextBlock Text="セットアップガイド" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <Border CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontSize="16" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SetupInstructionsText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <CheckBox Content="終了時に Core Temp も終了する（同意時のみ）" IsChecked="{Binding CloseCoreTempOnExitConsent}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding MainFeatureText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{Binding RestrictionText}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Charts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Style="{DynamicResource ChartCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Temperature (°C)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Latest: " Style="{DynamicResource MetricSubStyle}" />
                                        <TextBlock Text="{Binding TempLatestText}" Style="{DynamicResource MetricSubStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Canvas Grid.Row="1" Height="150" Margin="0,10,0,0">
                                    <Rectangle Width="1020" Height="150" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="6" RadiusY="6" />
                                    <Path Data="{Binding TempChartData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                </Canvas>
                            </Grid>
                        </Border>

                        <Border Style="{DynamicResource ChartCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU Utilization (%)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Latest: " Style="{DynamicResource MetricSubStyle}" />
                                        <TextBlock Text="{Binding CpuLatestText}" Style="{DynamicResource MetricSubStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Canvas Grid.Row="1" Height="150" Margin="0,10,0,0">
                                    <Rectangle Width="1020" Height="150" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="6" RadiusY="6" />
                                    <Path Data="{Binding CpuChartData}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" />
                                </Canvas>
                            </Grid>
                        </Border>

                        <Border Style="{DynamicResource ChartCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Memory Utilization (%)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Latest: " Style="{DynamicResource MetricSubStyle}" />
                                        <TextBlock Text="{Binding MemLatestText}" Style="{DynamicResource MetricSubStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Canvas Grid.Row="1" Height="150" Margin="0,10,0,0">
                                    <Rectangle Width="1020" Height="150" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="6" RadiusY="6" />
                                    <Path Data="{Binding MemChartData}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="2" />
                                </Canvas>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="System Profile">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="同意してランキング用カテゴリを生成する（ローカルのみ）" IsChecked="{Binding OptInConsent}" />
                        <Button Content="プロファイル更新" Width="130" Margin="12,0,0,0" Click="RefreshProfileButton_OnClick" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="OS Major" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProfileOsMajor}" />
                            <TextBlock Grid.Column="2" Text="OS Build Bucket" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Column="3" Text="{Binding ProfileOsBuildBucket}" />

                            <TextBlock Grid.Row="1" Text="CPU Brand" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileCpuBrand}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="CPU Cores" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ProfileCoreText}" />

                            <TextBlock Grid.Row="2" Text="Memory Bucket" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileMemoryBucket}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="GPU" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ProfileGpuName}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Text="Storage Type" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileStorageType}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Storage Bucket" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding ProfileStorageBucket}" />

                            <TextBlock Grid.Row="4" Text="Device Class" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileDeviceClass}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Temp Provider" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding ProfileTempProvider}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Expander Header="Profile JSON" IsExpanded="True" Margin="0,0,8,0">
                            <TextBox Text="{Binding ProfileText}" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </Expander>
                        <Expander Grid.Column="1" Header="Ranking Category JSON" IsExpanded="True" Margin="8,0,0,0">
                            <TextBox Text="{Binding RankingProfileText}" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Log" Margin="0,0,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="ログをコピー" Width="120" Click="CopyLogsButton_OnClick" />
                                <Button Content="再接続" Width="100" Margin="8,0,0,0" Click="ReconnectButton_OnClick" />
                                <Button Content="SensorHelper再起動" Width="150" Margin="8,0,0,0" Click="RestartHelperButton_OnClick" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" />
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Diagnostics (sensors)">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="診断更新" Width="100" Click="RefreshDiagnosticsButton_OnClick" />
                                <Button Content="診断エクスポート" Width="140" Margin="8,0,0,0" Click="ExportDiagnosticsButton_OnClick" />
                            </StackPanel>
                            <TextBox Text="{Binding DiagnosticSensorsText}" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True" />
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
