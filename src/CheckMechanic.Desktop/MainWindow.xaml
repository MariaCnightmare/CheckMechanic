<Window x:Class="CheckMechanic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic" Height="900" Width="1440" MinWidth="1100" MinHeight="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="290" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource CardStyle}" Padding="16" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="CheckMechanic" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Local Telemetry Dashboard" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Style="{DynamicResource StatusBadgeStyle}" Margin="12,0,12,0"
                        Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" />
                </Border>

                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Core Tempを起動/前面へ" Margin="0,0,8,0" Width="176" Click="LaunchOrActivateCoreTempButton_OnClick" />
                    <Button Content="再接続" Margin="0,0,8,0" Width="96" Click="ReconnectButton_OnClick" />
                    <Button Content="再チェック" Margin="0,0,8,0" Width="104" Click="RecheckButton_OnClick" />
                    <Button Content="SensorHelper再起動" Margin="0,0,8,0" Width="140" Click="RestartHelperButton_OnClick" />
                    <Button Content="管理者で再試行" Margin="0,0,8,0" Width="130" Click="RestartHelperAsAdminButton_OnClick" />
                    <Button Content="診断エクスポート" Width="132" Click="ExportDiagnosticsButton_OnClick" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <UniformGrid Rows="2" Columns="3" Margin="0,0,0,12">
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="104" Height="104" VerticalAlignment="Top">
                            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="12" />
                            <Path Data="{Binding TempRingArcData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="{Binding TempRingCenterText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="CPU Temperature" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding CpuTemperatureText}" Style="{DynamicResource GlowValueStyle}" FontSize="30" />
                            <TextBlock Text="{Binding TempSourceText}" Style="{DynamicResource MetricSubStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Latest " Style="{DynamicResource MetricSubStyle}" />
                                <TextBlock Text="{Binding TempLatestText}" Style="{DynamicResource MetricSubStyle}" />
                                <TextBlock Text="  Min " Style="{DynamicResource MetricSubStyle}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding TempMin60Text}" Style="{DynamicResource MetricSubStyle}" />
                                <TextBlock Text="  Max " Style="{DynamicResource MetricSubStyle}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding TempMax60Text}" Style="{DynamicResource MetricSubStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Visibility="{Binding RestrictionVisibility}" Background="#33201218" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,116,0,0" Grid.ColumnSpan="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" Foreground="{DynamicResource WarningBrush}" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SetupInstructionsText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="CPU Utilization" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding CpuUtilizationText}" Style="{DynamicResource MetricValueStyle}" />
                        <ProgressBar Height="10" Margin="0,10,0,0" Value="{Binding CpuUtilizationValue}" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Surface2Brush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Latest " Style="{DynamicResource MetricSubStyle}" />
                            <TextBlock Text="{Binding CpuLatestText}" Style="{DynamicResource MetricSubStyle}" />
                            <TextBlock Text="  1m avg " Style="{DynamicResource MetricSubStyle}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding CpuAvg60Text}" Style="{DynamicResource MetricSubStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding MemoryText}" Style="{DynamicResource MetricValueStyle}" FontSize="26" />
                        <ProgressBar Height="10" Margin="0,10,0,0" Value="{Binding MemoryUtilizationValue}" Maximum="100" Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource Surface2Brush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Available " Style="{DynamicResource MetricSubStyle}" />
                            <TextBlock Text="{Binding MemoryAvailableText}" Style="{DynamicResource MetricSubStyle}" />
                            <TextBlock Text="  Latest " Style="{DynamicResource MetricSubStyle}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding MemLatestText}" Style="{DynamicResource MetricSubStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Disk Throughput" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DiskText}" Style="{DynamicResource MetricValueStyle}" FontSize="24" />
                        <TextBlock Text="↓ Read / ↑ Write" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Network" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding NetText}" Style="{DynamicResource MetricValueStyle}" FontSize="24" />
                        <TextBlock Text="↓ Rx / ↑ Tx" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="PerfScore" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Grid.Row="1" Text="{Binding PerfScoreText}" Style="{DynamicResource GlowValueStyle}" FontSize="34" Margin="0,4,0,10" />

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="CPU" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Height="8" Margin="8,0" Value="{Binding ScoreCpuValue}" Maximum="100" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding ScoreCpuText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Memory" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Height="8" Margin="8,0" Value="{Binding ScoreMemValue}" Maximum="100" Foreground="{DynamicResource WarningBrush}"/><TextBlock Grid.Column="2" Text="{Binding ScoreMemText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Disk" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Height="8" Margin="8,0" Value="{Binding ScoreDiskValue}" Maximum="100" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Grid.Column="2" Text="{Binding ScoreDiskText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Network" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Height="8" Margin="8,0" Value="{Binding ScoreNetValue}" Maximum="100" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding ScoreNetText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Thermal" Style="{DynamicResource MetricSubStyle}"/><ProgressBar Grid.Column="1" Height="8" Margin="8,0" Value="{Binding ScoreTempValue}" Maximum="100" Foreground="{DynamicResource DangerBrush}"/><TextBlock Grid.Column="2" Text="{Binding ScoreTempText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right"/></Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <UniformGrid Grid.Row="1" Columns="3">
                <Border Style="{DynamicResource ChartCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Temperature (直近60秒)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <Canvas Grid.Row="1" Height="160" Margin="0,8,0,0"><Rectangle Width="430" Height="160" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="6" RadiusY="6"/><Path Data="{Binding TempChartData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/></Canvas>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource ChartCardStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="CPU Util (直近60秒)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <Canvas Grid.Row="1" Height="160" Margin="0,8,0,0"><Rectangle Width="430" Height="160" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="6" RadiusY="6"/><Path Data="{Binding CpuChartData}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"/></Canvas>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource ChartCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Memory Util (直近60秒)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <Canvas Grid.Row="1" Height="160" Margin="0,8,0,0"><Rectangle Width="430" Height="160" Fill="{DynamicResource Surface2Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" RadiusX="6" RadiusY="6"/><Path Data="{Binding MemChartData}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="2"/></Canvas>
                    </Grid>
                </Border>
            </UniformGrid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="System Profile" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <CheckBox Content="Opt-in" IsChecked="{Binding OptInConsent}" Margin="14,1,0,0" />
                        <Button Content="更新" Margin="8,0,0,0" Width="90" Click="RefreshProfileButton_OnClick" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="OS" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding ProfileOsMajor}"/>
                        <TextBlock Grid.Column="2" Text="Build" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Column="3" Text="{Binding ProfileOsBuildBucket}"/>
                        <TextBlock Grid.Row="1" Text="CPU" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileCpuBrand}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Cores" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ProfileCoreText}"/>
                        <TextBlock Grid.Row="2" Text="Memory" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileMemoryBucket}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="GPU" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ProfileGpuName}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="Storage" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileStorageType}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Capacity" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding ProfileStorageBucket}"/>
                        <TextBlock Grid.Row="4" Text="Device" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileDeviceClass}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Temp Provider" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding ProfileTempProvider}"/>
                        <TextBlock Grid.Row="5" Text="Ranking Category" Style="{DynamicResource MetricLabelStyle}"/><TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding RankingProfileText}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,8"/>

                    <Expander Grid.Row="2" Header="Diagnostics ▼" IsExpanded="False">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="ログをコピー" Width="120" Click="CopyLogsButton_OnClick" />
                                    <Button Content="診断更新" Width="110" Margin="8,0,0,0" Click="RefreshDiagnosticsButton_OnClick" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding DiagnosticSensorsText}" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True" Margin="8,0,0,0" />
                        </Grid>
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
