<Window x:Class="CheckMechanic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic"
        Width="1366"
        Height="860"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border IsHitTestVisible="False">
            <Grid>
                <Rectangle Fill="{DynamicResource BackgroundPatternBrush}" Opacity="0.14" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#1A49FF86" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.28" />
                            <GradientStop Color="#33000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource BackgroundBrush}">
            <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="16" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CheckMechanic" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Local Telemetry Dashboard" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{DynamicResource StatusBadgeStyle}"
                            Margin="12,0,12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding StatusBadgeBackground}"
                            BorderBrush="{Binding StatusBadgeBorder}">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" />
                    </Border>

                    <Grid Grid.Column="2"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="再チェック"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Width="100"
                                Height="34"
                                Padding="10,4"
                                FontSize="12"
                                Margin="0,0,8,0"
                                Click="RecheckButton_OnClick" />

                        <Button Grid.Column="1"
                                Content="Core Temp 起動/前面"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="156"
                                Height="34"
                                Padding="10,4"
                                FontSize="12"
                                Margin="0,0,8,0"
                                Click="LaunchOrActivateCoreTempButton_OnClick" />

                        <CheckBox Grid.Column="2"
                                  Content="終了時に Core Temp も終了"
                                  IsChecked="{Binding CloseCoreTempOnExitConsent, Mode=TwoWay}"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  ToolTip="アプリ終了時に Core Temp を自動終了します（手動起動分も対象）" />

                        <Button Grid.Column="3"
                                Content="UPDATE"
                                Style="{DynamicResource UpdateBadgeButtonStyle}"
                                Height="34"
                                Margin="0,0,8,0"
                                Visibility="{Binding UpdateBadgeVisibility}"
                                ToolTip="{Binding UpdateBadgeTooltip}"
                                Click="UpdateBadgeButton_OnClick" />

                        <Button x:Name="MoreActionsButton"
                                Grid.Column="4"
                                Content="⋯"
                                Style="{DynamicResource TertiaryButtonStyle}"
                                Width="42"
                                Height="34"
                                FontSize="16"
                                Click="MoreActionsButton_OnClick">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="管理者で再試行" Click="RestartHelperAsAdminButton_OnClick" />
                                    <MenuItem Header="SensorHelper再起動" Click="RestartHelperButton_OnClick" />
                                    <MenuItem Header="再接続" Click="ReconnectButton_OnClick" />
                                    <MenuItem Header="ウィジェットモードへ" Click="OpenWidgetModeButton_OnClick" />
                                    <Separator />
                                    <MenuItem Header="診断エクスポート" Click="ExportDiagnosticsButton_OnClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Restriction / Setup -->
            <Border Grid.Row="1"
                    Style="{DynamicResource CardStyle}"
                    Margin="0,16,0,0"
                    Visibility="{Binding RestrictionVisibility}"
                    BorderBrush="{DynamicResource DangerBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding RestrictionText}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{Binding SetupInstructionsText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MainFeatureText}" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- KPI Row -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="74" Height="74" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="8" />
                            <Path Data="{Binding TempRingArcData}"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <TextBlock Text="{Binding TempRingCenterText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Temperature" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding CpuTemperatureText}" Style="{DynamicResource GlowValueStyle}" />
                            <TextBlock Text="{Binding TempStatsText}" Style="{DynamicResource MetricSubStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding CpuKpiText}" Style="{DynamicResource MetricValueStyle}" />
                        <ProgressBar Height="8"
                                     Margin="0,10,0,0"
                                     Value="{Binding CpuUtilizationValue}"
                                     Maximum="100"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource Surface2Brush}" />
                        <TextBlock Text="{Binding CpuAvgText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CpuDetailText}" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding GpuKpiText}" Style="{DynamicResource MetricValueStyle}" />
                        <ProgressBar Height="8"
                                     Margin="0,10,0,0"
                                     Value="{Binding GpuUtilizationValue}"
                                     Maximum="100"
                                     Foreground="{DynamicResource SuccessBrush}"
                                     Background="{DynamicResource Surface2Brush}" />
                        <TextBlock Text="{Binding GpuSubText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding MemoryKpiText}" Style="{DynamicResource MetricValueStyle}" />
                        <ProgressBar Height="8"
                                     Margin="0,10,0,0"
                                     Value="{Binding MemoryUtilizationValue}"
                                     Maximum="100"
                                     Foreground="{DynamicResource WarningBrush}"
                                     Background="{DynamicResource Surface2Brush}" />
                        <TextBlock Text="{Binding MemorySubText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Disk I/O" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DiskText}" Style="{DynamicResource MetricValueStyle}" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DiskCapacityText}" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Latest: " Style="{DynamicResource MetricSubStyle}" />
                            <TextBlock Text="{Binding DiskLatestText}" Style="{DynamicResource MetricSubStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PerfScore" Style="{DynamicResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding PerfScoreText}" Style="{DynamicResource GlowValueStyle}" />
                        <TextBlock Text="{Binding PerfSummaryText}" Style="{DynamicResource MetricSubStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Network / Battery -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Network" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding NetText}"
                                       Style="{DynamicResource MetricValueStyle}"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding NetDetailTooltipText}" />
                            <TextBlock Text="{Binding NetMetaText}" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding NetLatestText}" Style="{DynamicResource MetricSubStyle}" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Battery" Style="{DynamicResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding BatteryText}" Style="{DynamicResource MetricValueStyle}" FontSize="18" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastUpdateText}"
                                   Style="{DynamicResource MetricSubStyle}"
                                   VerticalAlignment="Bottom"
                                   ToolTip="{Binding TempSourceTooltipText}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Charts + Right Column -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Charts -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Temp -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource ChartCardStyle}" Margin="0,0,8,12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Temperature (60s)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding TempLatestText}" Style="{DynamicResource MetricSubStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="288" />
                                </Grid.ColumnDefinitions>

                                <Canvas Width="72" Height="180" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding TempChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Canvas.Top="{Binding Y}" Style="{DynamicResource AxisLabelStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <Canvas Grid.Column="1" Width="288" Height="180" ClipToBounds="True">
                                    <Rectangle Width="288" Height="180"
                                               Fill="{DynamicResource Surface2Brush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1"
                                               RadiusX="8" RadiusY="8" />
                                    <ItemsControl ItemsSource="{Binding TempChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="0" X2="288"
                                                      Y1="{Binding Y}" Y2="{Binding Y}"
                                                      Stroke="#33435A69"
                                                      StrokeThickness="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Path Data="{Binding TempChartData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource AccentBrush}"
                                             Canvas.Left="{Binding TempLatestPointX}"
                                             Canvas.Top="{Binding TempLatestPointY}"
                                             Visibility="{Binding TempLatestPointVisibility}" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CPU -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{DynamicResource ChartCardStyle}" Margin="8,0,0,12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU (60s)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuLatestText}" Style="{DynamicResource MetricSubStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="288" />
                                </Grid.ColumnDefinitions>

                                <Canvas Width="72" Height="180" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding CpuChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Canvas.Top="{Binding Y}" Style="{DynamicResource AxisLabelStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <Canvas Grid.Column="1" Width="288" Height="180" ClipToBounds="True">
                                    <Rectangle Width="288" Height="180"
                                               Fill="{DynamicResource Surface2Brush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1"
                                               RadiusX="8" RadiusY="8" />
                                    <ItemsControl ItemsSource="{Binding CpuChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="0" X2="288"
                                                      Y1="{Binding Y}" Y2="{Binding Y}"
                                                      Stroke="#33435A69"
                                                      StrokeThickness="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Path Data="{Binding CpuChartData}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource SuccessBrush}"
                                             Canvas.Left="{Binding CpuLatestPointX}"
                                             Canvas.Top="{Binding CpuLatestPointY}"
                                             Visibility="{Binding CpuLatestPointVisibility}" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- GPU -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource ChartCardStyle}" Margin="0,0,8,12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GPU (60s)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuLatestText}" Style="{DynamicResource MetricSubStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="288" />
                                </Grid.ColumnDefinitions>

                                <Canvas Width="72" Height="180" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding GpuChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Canvas.Top="{Binding Y}" Style="{DynamicResource AxisLabelStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <Canvas Grid.Column="1" Width="288" Height="180" ClipToBounds="True">
                                    <Rectangle Width="288" Height="180"
                                               Fill="{DynamicResource Surface2Brush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1"
                                               RadiusX="8" RadiusY="8" />
                                    <ItemsControl ItemsSource="{Binding GpuChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="0" X2="288"
                                                      Y1="{Binding Y}" Y2="{Binding Y}"
                                                      Stroke="#33435A69"
                                                      StrokeThickness="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Path Data="{Binding GpuChartData}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="2" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource WarningBrush}"
                                             Canvas.Left="{Binding GpuLatestPointX}"
                                             Canvas.Top="{Binding GpuLatestPointY}"
                                             Visibility="{Binding GpuLatestPointVisibility}" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Memory -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{DynamicResource ChartCardStyle}" Margin="8,0,0,12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Memory (60s)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding MemLatestText}" Style="{DynamicResource MetricSubStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="288" />
                                </Grid.ColumnDefinitions>

                                <Canvas Width="72" Height="180" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding MemChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Canvas.Top="{Binding Y}" Style="{DynamicResource AxisLabelStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <Canvas Grid.Column="1" Width="288" Height="180" ClipToBounds="True">
                                    <Rectangle Width="288" Height="180"
                                               Fill="{DynamicResource Surface2Brush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1"
                                               RadiusX="8" RadiusY="8" />
                                    <ItemsControl ItemsSource="{Binding MemChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="0" X2="288"
                                                      Y1="{Binding Y}" Y2="{Binding Y}"
                                                      Stroke="#33435A69"
                                                      StrokeThickness="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Path Data="{Binding MemChartData}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="2" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource DangerBrush}"
                                             Canvas.Left="{Binding MemLatestPointX}"
                                             Canvas.Top="{Binding MemLatestPointY}"
                                             Visibility="{Binding MemLatestPointVisibility}" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Disk -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource ChartCardStyle}" Margin="0,0,8,0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Disk I/O (60s)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DiskLatestText}" Style="{DynamicResource MetricSubStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="288" />
                                </Grid.ColumnDefinitions>

                                <Canvas Width="72" Height="180" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding DiskChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Canvas.Top="{Binding Y}" Style="{DynamicResource AxisLabelStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <Canvas Grid.Column="1" Width="288" Height="180" ClipToBounds="True">
                                    <Rectangle Width="288" Height="180"
                                               Fill="{DynamicResource Surface2Brush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1"
                                               RadiusX="8" RadiusY="8" />
                                    <ItemsControl ItemsSource="{Binding DiskChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="0" X2="288"
                                                      Y1="{Binding Y}" Y2="{Binding Y}"
                                                      Stroke="#33435A69"
                                                      StrokeThickness="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Path Data="{Binding DiskChartData}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource SuccessBrush}"
                                             Canvas.Left="{Binding DiskLatestPointX}"
                                             Canvas.Top="{Binding DiskLatestPointY}"
                                             Visibility="{Binding DiskLatestPointVisibility}" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Network -->
                    <Border Grid.Row="2" Grid.Column="1" Style="{DynamicResource ChartCardStyle}" Margin="8,0,0,0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Network (60s)" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding NetLatestText}" Style="{DynamicResource MetricSubStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="288" />
                                </Grid.ColumnDefinitions>

                                <Canvas Width="72" Height="180" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding NetChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Canvas.Top="{Binding Y}" Style="{DynamicResource AxisLabelStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <Canvas Grid.Column="1" Width="288" Height="180" ClipToBounds="True">
                                    <Rectangle Width="288" Height="180"
                                               Fill="{DynamicResource Surface2Brush}"
                                               Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1"
                                               RadiusX="8" RadiusY="8" />
                                    <ItemsControl ItemsSource="{Binding NetChartTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="0" X2="288"
                                                      Y1="{Binding Y}" Y2="{Binding Y}"
                                                      Stroke="#33435A69"
                                                      StrokeThickness="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Path Data="{Binding NetChartData}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource AccentBrush}"
                                             Canvas.Left="{Binding NetLatestPointX}"
                                             Canvas.Top="{Binding NetLatestPointY}"
                                             Visibility="{Binding NetLatestPointVisibility}" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Column -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- System Profile -->
                    <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="System Profile" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <CheckBox Content="Opt-in" IsChecked="{Binding OptInConsent}" Margin="10,2,0,0" />
                                <Button Content="更新" Width="70" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="RefreshProfileButton_OnClick" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="OS" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProfileOsText}" />

                                <TextBlock Grid.Row="1" Text="CPU" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileCpuBrand}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Text="Cores" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileCoreText}" />

                                <TextBlock Grid.Row="3" Text="Memory" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileMemoryBucket}" />

                                <TextBlock Grid.Row="4" Text="GPU" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileGpuName}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Text="Storage" Style="{DynamicResource MetricLabelStyle}" />
                                <StackPanel Grid.Row="5" Grid.Column="1">
                                    <TextBlock Text="{Binding ProfileStorageText, StringFormat=Type: {0}}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DiskCapacityText}" Style="{DynamicResource MetricSubStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DiskUsageText, StringFormat=Usage: {0}}" Style="{DynamicResource MetricSubStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ProfileStorageModel, StringFormat=Model: {0}}" Style="{DynamicResource MetricSubStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ProfileStorageBusType, StringFormat=Bus: {0}}" Style="{DynamicResource MetricSubStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="Device" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProfileDeviceClass}" />

                                <TextBlock Grid.Row="7" Text="Provider" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProfileTempProvider}" />

                                <TextBlock Grid.Row="8" Text="Vendor" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ProfileMachineVendor}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="9" Text="Model" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ProfileMachineModel}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="10" Text="Uptime" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ProfileUptimeText}" />

                                <TextBlock Grid.Row="11" Text="GPU Driver" Style="{DynamicResource MetricLabelStyle}" />
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding ProfileGpuDriverVersion}" TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Score Breakdown -->
                    <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Score Breakdown" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

                            <Grid Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <Canvas Width="280" Height="230" ClipToBounds="True">
                                    <Polygon Points="{Binding RadarGrid100Points}" Stroke="#445F7180" StrokeThickness="1" Fill="Transparent" />
                                    <Polygon Points="{Binding RadarGrid80Points}" Stroke="#335F7180" StrokeThickness="1" Fill="Transparent" />
                                    <Polygon Points="{Binding RadarGrid60Points}" Stroke="#285F7180" StrokeThickness="1" Fill="Transparent" />
                                    <Polygon Points="{Binding RadarGrid40Points}" Stroke="#205F7180" StrokeThickness="1" Fill="Transparent" />
                                    <Polygon Points="{Binding RadarGrid20Points}" Stroke="#185F7180" StrokeThickness="1" Fill="Transparent" />

                                    <TextBlock Text="100" Canvas.Left="146" Canvas.Top="30" Style="{DynamicResource AxisLabelStyle}" Width="28" TextAlignment="Left" />
                                    <TextBlock Text="75" Canvas.Left="146" Canvas.Top="49" Style="{DynamicResource AxisLabelStyle}" Width="28" TextAlignment="Left" />
                                    <TextBlock Text="50" Canvas.Left="146" Canvas.Top="68" Style="{DynamicResource AxisLabelStyle}" Width="28" TextAlignment="Left" />
                                    <TextBlock Text="25" Canvas.Left="146" Canvas.Top="87" Style="{DynamicResource AxisLabelStyle}" Width="28" TextAlignment="Left" />
                                    <TextBlock Text="0" Canvas.Left="146" Canvas.Top="106" Style="{DynamicResource AxisLabelStyle}" Width="28" TextAlignment="Left" />

                                    <Line X1="140" Y1="115" X2="140" Y2="37" Stroke="#295F7180" StrokeThickness="1" />
                                    <Line X1="140" Y1="115" X2="207.6" Y2="76" Stroke="#295F7180" StrokeThickness="1" />
                                    <Line X1="140" Y1="115" X2="207.6" Y2="154" Stroke="#295F7180" StrokeThickness="1" />
                                    <Line X1="140" Y1="115" X2="140" Y2="193" Stroke="#295F7180" StrokeThickness="1" />
                                    <Line X1="140" Y1="115" X2="72.4" Y2="154" Stroke="#295F7180" StrokeThickness="1" />
                                    <Line X1="140" Y1="115" X2="72.4" Y2="76" Stroke="#295F7180" StrokeThickness="1" />

                                    <Polygon Points="{Binding RadarScorePoints}" Fill="#3A2ED8B3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />

                                    <TextBlock Text="{Binding RadarCpuLabel}" Canvas.Left="112" Canvas.Top="10" Style="{DynamicResource MetricSubStyle}" />
                                    <TextBlock Text="{Binding RadarMemLabel}" Canvas.Left="212" Canvas.Top="70" Style="{DynamicResource MetricSubStyle}" />
                                    <TextBlock Text="{Binding RadarDiskLabel}" Canvas.Left="212" Canvas.Top="154" Style="{DynamicResource MetricSubStyle}" />
                                    <TextBlock Text="{Binding RadarNetLabel}" Canvas.Left="110" Canvas.Top="205" Style="{DynamicResource MetricSubStyle}" />
                                    <TextBlock Text="{Binding RadarThermalLabel}" Canvas.Left="8" Canvas.Top="154" Style="{DynamicResource MetricSubStyle}" />
                                    <TextBlock Text="{Binding RadarGpuLabel}" Canvas.Left="8" Canvas.Top="70" Style="{DynamicResource MetricSubStyle}" />
                                </Canvas>
                            </Grid>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding ScoreInsights}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{DynamicResource MetricSubStyle}" Margin="0,2,0,0" TextWrapping="Wrap">
                                            <Run Text="•  " />
                                            <Run Text="{Binding ., Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Grid.Row="3" Header="詳細 ▼" Margin="0,8,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU" Style="{DynamicResource MetricSubStyle}" />
                                        <ProgressBar Grid.Column="1" Value="{Binding ScoreCpuValue}" Maximum="100" Height="8" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreCpuText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ScoreCpuReason}" Style="{DynamicResource MetricSubStyle}" Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Memory" Style="{DynamicResource MetricSubStyle}" />
                                        <ProgressBar Grid.Column="1" Value="{Binding ScoreMemValue}" Maximum="100" Height="8" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreMemText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ScoreMemReason}" Style="{DynamicResource MetricSubStyle}" Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Disk" Style="{DynamicResource MetricSubStyle}" />
                                        <ProgressBar Grid.Column="1" Value="{Binding ScoreDiskValue}" Maximum="100" Height="8" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreDiskText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ScoreDiskReason}" Style="{DynamicResource MetricSubStyle}" Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Network" Style="{DynamicResource MetricSubStyle}" />
                                        <ProgressBar Grid.Column="1" Value="{Binding ScoreNetValue}" Maximum="100" Height="8" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreNetText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ScoreNetReason}" Style="{DynamicResource MetricSubStyle}" Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Thermal" Style="{DynamicResource MetricSubStyle}" />
                                        <ProgressBar Grid.Column="1" Value="{Binding ScoreTempValue}" Maximum="100" Height="8" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreTempText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ScoreTempReason}" Style="{DynamicResource MetricSubStyle}" Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU" Style="{DynamicResource MetricSubStyle}" />
                                        <ProgressBar Grid.Column="1" Value="{Binding ScoreGpuValue}" Maximum="100" Height="8" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreGpuText}" Style="{DynamicResource MetricSubStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ScoreGpuReason}" Style="{DynamicResource MetricSubStyle}" Margin="0,0,0,8" />

                                    <TextBlock Text="{Binding LocalRankingText}" Style="{DynamicResource MetricSubStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>

                    <!-- Diagnostics -->
                    <Border Grid.Row="4" Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding DiagnosticsSummaryText}"
                                       Style="{DynamicResource MetricSubStyle}"
                                       Margin="0,6,0,8"
                                       TextWrapping="Wrap" />

                            <Expander Grid.Row="2" Header="Diagnostics ▼" IsExpanded="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="ログをコピー" Width="120" Click="CopyLogsButton_OnClick" />
                                            <Button Content="診断更新" Width="110" Margin="8,0,0,0" Click="RefreshDiagnosticsButton_OnClick" />
                                        </StackPanel>

                                        <TextBlock Text="provider_errors" Style="{DynamicResource MetricSubStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ProviderErrorsText}"
                                                 FontFamily="Consolas"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 IsReadOnly="True"
                                                 Height="72"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,8" />

                                        <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" Height="120" />
                                    </StackPanel>

                                    <Grid Grid.Column="1" Margin="8,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="120" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="120" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="sensors_raw" Style="{DynamicResource MetricSubStyle}" />
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding DiagnosticSensorsText}"
                                                 FontFamily="Consolas"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 IsReadOnly="True" />

                                        <TextBox Grid.Row="4"
                                                 Text="{Binding DiagnosticTelemetryText}"
                                                 FontFamily="Consolas"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 IsReadOnly="True" />
                                    </Grid>
                                </Grid>
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
