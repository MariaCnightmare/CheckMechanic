<Window x:Class="CheckMechanic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic" Height="640" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="CPU Temperature (Required)" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding CpuTemperatureText}" FontSize="48" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Grid.Row="2" Text="{Binding CpuUtilizationText}" FontSize="16" Margin="0,8,0,0" />
        <TextBlock Grid.Row="3" Text="{Binding RestrictionText}" FontSize="14" FontWeight="SemiBold" Foreground="DarkRed" Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="16" />
            <TextBlock Text="{Binding SetupInstructionsText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Core Tempを起動/前面へ" Width="190" Margin="0,0,8,0" Click="LaunchOrActivateCoreTempButton_OnClick" />
                <Button Content="再接続" Width="120" Margin="0,0,8,0" Click="ReconnectButton_OnClick" />
                <Button Content="再チェック" Width="120" Margin="0,0,8,0" Click="RecheckButton_OnClick" />
                <Button Content="SensorHelperを再起動" Width="180" Click="RestartHelperButton_OnClick" />
                <Button Content="管理者でSensorHelperを再起動して再試行" Width="300" Margin="8,0,0,0" Click="RestartHelperAsAdminButton_OnClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="自動で設定をONにする（実験的・同意必須）" IsChecked="{Binding ExperimentalAutoEnableConsent}" />
                <Button Content="実験: Shared Memory を自動でON" Width="240" Margin="8,0,0,0" Click="AutoEnableCoreTempSharedMemoryButton_OnClick" />
            </StackPanel>
            <CheckBox Content="終了時に Core Temp も終了する（同意時のみ）" IsChecked="{Binding CloseCoreTempOnExitConsent}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding MainFeatureText}" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Log" Margin="0,0,8,0">
                <ListBox ItemsSource="{Binding Logs}" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Diagnostics (sensors)">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="診断更新" Width="100" Click="RefreshDiagnosticsButton_OnClick" />
                        <Button Content="診断エクスポート" Width="140" Margin="8,0,0,0" Click="ExportDiagnosticsButton_OnClick" />
                    </StackPanel>
                    <TextBox Text="{Binding DiagnosticSensorsText}" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
