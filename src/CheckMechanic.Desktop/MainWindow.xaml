<Window x:Class="CheckMechanic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic" Height="480" Width="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="CPU Temperature" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding CpuTemperatureText}" FontSize="48" FontWeight="Bold" Margin="0,8,0,0" />

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="16" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="再接続" Width="120" Margin="0,0,8,0" Click="ReconnectButton_OnClick" />
                <Button Content="SensorHelperを再起動" Width="180" Click="RestartHelperButton_OnClick" />
            </StackPanel>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Log" Margin="0,16,0,0">
            <ListBox ItemsSource="{Binding Logs}" />
        </GroupBox>
    </Grid>
</Window>
