<Window x:Class="CheckMechanic.Desktop.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic Widget"
        Width="320"
        Height="150"
        MinWidth="260"
        MinHeight="136"
        MaxWidth="360"
        MaxHeight="190"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ContextMenuOpening="WidgetWindow_ContextMenuOpening"
        MouseEnter="WidgetWindow_MouseEnter"
        MouseLeave="WidgetWindow_MouseLeave"
        Activated="WidgetWindow_OnActivated"
        Deactivated="WidgetWindow_OnDeactivated"
        MouseLeftButtonDown="WidgetRoot_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="WidgetTextShadow"
                          Color="#11000000"
                          BlurRadius="6"
                          ShadowDepth="0"
                          Opacity="0.95" />
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem Header="フルUIを開く" Click="OpenFullUiMenuItem_OnClick" />
            <MenuItem x:Name="TopmostMenuItem"
                      Header="最前面"
                      IsCheckable="True"
                      Click="TopmostMenuItem_OnClick" />
            <MenuItem x:Name="ClickThroughMenuItem"
                      Header="クリック透過"
                      IsCheckable="True"
                      Click="ClickThroughMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="透明度" StaysOpenOnClick="True">
                <StackPanel Orientation="Horizontal" Margin="4,2">
                    <TextBlock Text="{Binding WidgetOpacityLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="OpacitySlider"
                            Minimum="0.65"
                            Maximum="0.95"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            Width="120"
                            Value="{Binding WidgetOpacitySetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ValueChanged="OpacitySlider_OnValueChanged" />
                </StackPanel>
            </MenuItem>
            <MenuItem Header="位置リセット（左下）" Click="ResetPositionMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="閉じる" Click="CloseMenuItem_OnClick" />
        </ContextMenu>
    </Window.ContextMenu>
    <Border Margin="4"
            Padding="6"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="4"
                    CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}"
                    Opacity="{Binding WidgetBackgroundOpacity}" />

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{DynamicResource StatusBadgeStyle}"
                            Background="{Binding StatusBadgeBackground}"
                            BorderBrush="{Binding StatusBadgeBorder}"
                            Padding="8,3"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" />
                    </Border>
                    <TextBlock Text="Widget"
                               Style="{DynamicResource MetricSubStyle}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="⋯"
                        Width="34"
                        Height="26"
                        Style="{DynamicResource TertiaryButtonStyle}"
                        Click="MenuButton_OnClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="132" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Temp" Style="{DynamicResource MetricSubStyle}" Foreground="{DynamicResource TextBrush}" />
                <Border Grid.Column="2"
                        Background="#44202621"
                        CornerRadius="4"
                        Padding="5,1,5,1"
                        MinWidth="132">
                    <TextBlock Text="{Binding CpuTemperatureText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CpuTemperatureText}"
                               Foreground="{DynamicResource AccentBrush}"
                               Effect="{StaticResource WidgetTextShadow}" />
                </Border>

                <TextBlock Grid.Row="1" Text="CPU/Mem" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                <Border Grid.Row="1"
                        Grid.Column="2"
                        Background="#44202621"
                        CornerRadius="4"
                        Padding="5,1,5,1"
                        Margin="0,4,0,0"
                        MinWidth="132">
                    <TextBlock Text="{Binding CpuMemText}"
                               FontSize="11"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CpuMemText}"
                               Foreground="{DynamicResource TextBrush}"
                               Effect="{StaticResource WidgetTextShadow}" />
                </Border>

                <TextBlock Grid.Row="2" Text="PerfScore" Style="{DynamicResource MetricSubStyle}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                <Border Grid.Row="2"
                        Grid.Column="2"
                        Background="#44202621"
                        CornerRadius="4"
                        Padding="5,1,5,1"
                        Margin="0,4,0,0"
                        MinWidth="132">
                    <TextBlock Text="{Binding PerfScoreText}"
                               FontSize="11"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PerfScoreText}"
                               Foreground="{DynamicResource TextBrush}"
                               Effect="{StaticResource WidgetTextShadow}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,2,0,2">
                <TextBlock Text="{Binding SparklineTitleText}"
                           Style="{DynamicResource MetricSubStyle}"
                           FontSize="10"
                           Foreground="{DynamicResource TextBrush}" />
                <Border x:Name="TempSparkHost"
                        Height="28"
                        Margin="0,1,0,0"
                        CornerRadius="4"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        SizeChanged="TempSparkHost_OnSizeChanged">
                    <Canvas Width="{Binding SparklineWidth}" Height="24" ClipToBounds="True">
                        <Path Data="{Binding TempSparkPath}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" />
                    </Canvas>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Text="{Binding LastUpdateText, StringFormat=Updated {0}}"
                       Style="{DynamicResource MetricSubStyle}"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Right"
                       FontSize="10"
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource TextBrush}" />
        </Grid>
    </Border>
</Window>
