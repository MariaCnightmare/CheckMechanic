<Window x:Class="CheckMechanic.Desktop.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic Widget"
        Width="364"
        Height="168"
        MinWidth="340"
        MinHeight="160"
        MaxWidth="420"
        MaxHeight="220"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ContextMenuOpening="WidgetWindow_ContextMenuOpening"
        MouseEnter="WidgetWindow_MouseEnter"
        MouseLeave="WidgetWindow_MouseLeave"
        MouseLeftButtonDown="WidgetRoot_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem Header="フルUIを開く" Click="OpenFullUiMenuItem_OnClick" />
            <MenuItem x:Name="TopmostMenuItem"
                      Header="最前面"
                      IsCheckable="True"
                      Click="TopmostMenuItem_OnClick" />
            <MenuItem x:Name="ClickThroughMenuItem"
                      Header="クリック透過"
                      IsCheckable="True"
                      Click="ClickThroughMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="透明度" StaysOpenOnClick="True">
                <StackPanel Orientation="Horizontal" Margin="4,2">
                    <TextBlock Text="{Binding WidgetOpacityLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="OpacitySlider"
                            Minimum="0.65"
                            Maximum="0.95"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            Width="120"
                            Value="{Binding WidgetOpacitySetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ValueChanged="OpacitySlider_OnValueChanged" />
                </StackPanel>
            </MenuItem>
            <MenuItem Header="位置リセット（左下）" Click="ResetPositionMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="閉じる" Click="CloseMenuItem_OnClick" />
        </ContextMenu>
    </Window.ContextMenu>
    <Border Margin="6"
            Padding="8"
            CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="4"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    Opacity="{Binding WidgetBackgroundOpacity}" />

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{DynamicResource StatusBadgeStyle}"
                            Background="{Binding StatusBadgeBackground}"
                            BorderBrush="{Binding StatusBadgeBorder}"
                            Padding="8,3"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" />
                    </Border>
                    <TextBlock Text="Widget Mode" Style="{DynamicResource MetricSubStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="⋯"
                        Width="34"
                        Height="26"
                        Style="{DynamicResource TertiaryButtonStyle}"
                        Click="MenuButton_OnClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,6,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Temp" Style="{DynamicResource MetricSubStyle}" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding CpuTemperatureText}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CpuTemperatureText}"
                           Foreground="{DynamicResource AccentBrush}" />

                <TextBlock Grid.Row="1" Text="CPU / Mem" Style="{DynamicResource MetricSubStyle}" Margin="0,5,0,0" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="{Binding CpuMemText}"
                           Style="{DynamicResource MetricSubStyle}"
                           Margin="0,5,0,0"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CpuMemText}"
                           Foreground="{DynamicResource TextBrush}" />

                <TextBlock Grid.Row="2" Text="PerfScore" Style="{DynamicResource MetricSubStyle}" Margin="0,5,0,0" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="{Binding PerfScoreText}"
                           Style="{DynamicResource MetricSubStyle}"
                           Margin="0,5,0,0"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding PerfScoreText}"
                           Foreground="{DynamicResource TextBrush}" />

                <TextBlock Grid.Row="3" Text="Min/Max 1h" Style="{DynamicResource MetricSubStyle}" Margin="0,5,0,0" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="{Binding TempMinMaxHourText}"
                           Style="{DynamicResource MetricSubStyle}"
                           Margin="0,5,0,0"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TempMinMaxHourText}"
                           Foreground="{DynamicResource TextBrush}" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,6,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Temp 30s" Style="{DynamicResource MetricSubStyle}" FontSize="11" />
                    <Border Height="22" CornerRadius="4" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Canvas Width="152" Height="20" ClipToBounds="True">
                            <Path Data="{Binding TempSparkPath}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" />
                        </Canvas>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="CPU 30s" Style="{DynamicResource MetricSubStyle}" FontSize="11" />
                    <Border Height="22" CornerRadius="4" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Canvas Width="152" Height="20" ClipToBounds="True">
                            <Path Data="{Binding CpuSparkPath}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.6" />
                        </Canvas>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="{Binding LastUpdateText, StringFormat=Updated {0}}"
                       Style="{DynamicResource MetricSubStyle}"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Right"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextBrush}" />
        </Grid>
    </Border>
</Window>
