<Window x:Class="CheckMechanic.Desktop.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckMechanic Widget"
        Width="344"
        Height="188"
        MinWidth="320"
        MinHeight="160"
        MaxWidth="420"
        MaxHeight="260"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        ContextMenuOpening="WidgetWindow_ContextMenuOpening"
        MouseLeftButtonDown="WidgetRoot_MouseLeftButtonDown">
    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem Header="フルUIを開く" Click="OpenFullUiMenuItem_OnClick" />
            <MenuItem x:Name="TopmostMenuItem"
                      Header="最前面"
                      IsCheckable="True"
                      Click="TopmostMenuItem_OnClick" />
            <MenuItem Header="位置リセット（左下）" Click="ResetPositionMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="閉じる" Click="CloseMenuItem_OnClick" />
        </ContextMenu>
    </Window.ContextMenu>
    <Border Margin="10"
            Padding="12"
            CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{DynamicResource StatusBadgeStyle}"
                            Background="{Binding StatusBadgeBackground}"
                            BorderBrush="{Binding StatusBadgeBorder}"
                            Padding="8,3"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                    <TextBlock Text="Widget Mode" Style="{DynamicResource MetricSubStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="⋯"
                        Width="32"
                        Height="28"
                        Style="{DynamicResource TertiaryButtonStyle}"
                        Click="MenuButton_OnClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Temp" Style="{DynamicResource MetricSubStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding CpuTemperatureText}" Style="{DynamicResource MetricValueStyle}" TextAlignment="Right" />

                <TextBlock Grid.Row="1" Text="CPU / Mem" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuMemText}" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" TextAlignment="Right" />

                <TextBlock Grid.Row="2" Text="PerfScore" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PerfScoreText}" Style="{DynamicResource MetricSubStyle}" Margin="0,8,0,0" TextAlignment="Right" />
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding LastUpdateText, StringFormat=Updated {0}}"
                       Style="{DynamicResource AxisLabelStyle}"
                       HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
