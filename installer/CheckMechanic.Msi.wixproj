<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputName>CheckMechanic</OutputName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\dist\app</AppPublishDir>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\installer\</OutputPath>
    <DefineConstants>AppPublishDir=$(AppPublishDir);ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
  </ItemGroup>
</Project>
