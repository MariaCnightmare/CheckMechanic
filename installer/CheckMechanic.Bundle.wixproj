<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <OutputName>CheckMechanicBootstrapper</OutputName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\dist\installer\CheckMechanic.msi</MsiPath>
    <CoreTempOfficialUrl Condition="'$(CoreTempOfficialUrl)' == ''">https://www.alcpu.com/CoreTemp/Core-Temp-setup.exe</CoreTempOfficialUrl>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\installer\</OutputPath>
    <SuppressPdbOutput>true</SuppressPdbOutput>
    <DefineConstants>BundleVersion=$(Version);MsiPath=$(MsiPath);CoreTempOfficialUrl=$(CoreTempOfficialUrl)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>
</Project>
