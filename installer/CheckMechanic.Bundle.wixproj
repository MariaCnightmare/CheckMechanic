<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <OutputName>Setup</OutputName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\dist\installer\CheckMechanic.msi</MsiPath>
    <CoreTempDownloadUrl Condition="'$(CoreTempDownloadUrl)' == ''">https://www.alcpu.com/CoreTemp/Core-Temp-setup.exe</CoreTempDownloadUrl>
    <UseLocalCoreTempPayload Condition="'$(UseLocalCoreTempPayload)' == ''">0</UseLocalCoreTempPayload>
    <CoreTempPayloadPath Condition="'$(CoreTempPayloadPath)' == ''">$(MSBuildThisFileDirectory)payload\CoreTempSetup.exe</CoreTempPayloadPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\installer\</OutputPath>
    <SuppressPdbOutput>true</SuppressPdbOutput>
    <DefineConstants>BundleVersion=$(Version);MsiPath=$(MsiPath);CoreTempDownloadUrl=$(CoreTempDownloadUrl);UseLocalCoreTempPayload=$(UseLocalCoreTempPayload);CoreTempPayloadPath=$(CoreTempPayloadPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>
</Project>
