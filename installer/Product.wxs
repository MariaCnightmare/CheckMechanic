<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="CheckMechanic"
           Manufacturer="CheckMechanic"
           Version="$(var.ProductVersion)"
           UpgradeCode="2E5A5B4E-1258-45D5-BE95-2E8ED90D8CD2"
           Scope="perMachine"
           InstallerVersion="500"
           Language="1041">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CheckMechanic" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuCheckMechanicFolder" Name="CheckMechanic" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles">
      <Component Id="DesktopExeComponent" Directory="INSTALLFOLDER" Guid="*">
        <File Id="DesktopExeFile" Source="$(var.AppPublishDir)\CheckMechanic.Desktop.exe" KeyPath="yes" />
      </Component>
      <Component Id="SensorHelperExeComponent" Directory="INSTALLFOLDER" Guid="*">
        <File Id="SensorHelperExeFile" Source="$(var.AppPublishDir)\CheckMechanic.SensorHelper.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShellEntries">
      <Component Id="StartMenuShortcutComponent" Directory="ProgramMenuCheckMechanicFolder" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuCheckMechanicFolder"
                  Name="CheckMechanic"
                  Description="CheckMechanic Desktop"
                  Target="[INSTALLFOLDER]CheckMechanic.Desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramMenuCheckMechanicFolder"
                      Directory="ProgramMenuCheckMechanicFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\CheckMechanic"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="CheckMechanic" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ShellEntries" />
    </Feature>
  </Package>
</Wix>
